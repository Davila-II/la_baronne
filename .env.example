# ============================================================
# DjoKhouse SCI — Variables d'environnement
# Copie ce fichier en .env.local pour le dev
# NE JAMAIS commiter ce fichier avec les vraies valeurs !
# ============================================================

# --- Supabase PostgreSQL ---
# Connection string complète (depuis Supabase > Settings > Database > URI)
SUPABASE_DB_URL=postgresql://postgres:[TON_MOT_DE_PASSE]@db.[TON_ID].supabase.co:5432/postgres

# --- Supabase API (pour le Storage) ---
SUPABASE_URL=https://[TON_ID].supabase.co
SUPABASE_SERVICE_KEY=[TA_SERVICE_ROLE_KEY]

# --- Sécurité sessions (cookie signé) ---
# Génère avec : php -r "echo bin2hex(random_bytes(32));"
APP_SECRET=[UNE_LONGUE_CHAINE_ALEATOIRE_64_CHARS]

# ============================================================
# DjoKhouse SCI — Variables d'environnement
# Copie ce fichier en .env.local pour le dev
# NE JAMAIS commiter ce fichier avec les vraies valeurs !
# ============================================================

# --- Supabase PostgreSQL ---
SUPABASE_DB_URL=postgresql://postgres:[USERNAME]:[PASSWORD]@[HOST]:[PORT]/postgres

# --- Supabase API (Storage) ---
SUPABASE_URL=https://[PROJECT_ID].supabase.co
SUPABASE_SERVICE_KEY=[YOUR_SUPABASE_SERVICE_ROLE_KEY]

# --- Sécurité sessions ---
APP_SECRET=[RANDOM_SECRET_KEY]
